//! Name resolver with an explicit scope tree and parent links.
//!
//! Each scope keeps an optional parent ID, creating a tree that enables O(depth) name lookup.
//! This replaces the old flat Vec<HashMap> stack used before Phase 2.

use crate::ast::{Program, Stmt};
use std::collections::HashMap;

// ---------------------------------------------------------------------------
// Scope types
// ---------------------------------------------------------------------------

/// Unique identifier for a scope within a compilation unit.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct ScopeId(usize);

impl ScopeId {
    fn next() -> Self { ScopeId(NEXT.fetch_add(1)) }
}

use std::sync::atomic::{AtomicUsize, Ordering};
static NEXT: AtomicUsize = AtomicUsize::new(1);

/// A single lexical scope with an optional parent link.
#[derive(Debug, Clone)]
pub struct Scope {
    pub id: ScopeId,
    /// The ID of the parent scope. `None` only for the root.
    pub parent_id: Option<ScopeId>,
    /// Names bound at this level.
    pub bindings: HashMap<String, DefId>,
}

impl Scope {
    /// Creates the root scope (id=0, no parent).
    pub fn root() -> Scope {
        Scope { id: ScopeId(0), parent_id: None, bindings: HashMap::new() }
    }
    /// Creates a child scope with the given parent.
    pub fn child(parent_id: ScopeId) -> Scope {
        Scope { id: ScopeId::next(), parent_id: Some(parent_id), bindings: HashMap::new() }
    }
    /// Looks up `name` in this scope only (no parent walk).
    pub fn get(&self, name: &str) -> Option<DefId> {
        self.bindings.get(name).copied()
    }
    /// Binds a name in this scope.
    pub fn put(&mut self, name: String, id: DefId) {
        self.bindings.insert(name, id);
    }
}

// ---------------------------------------------------------------------------
// Definition IDs
// ---------------------------------------------------------------------------

/// Definition identifier (crate-local index).
pub type DefId = usize;

fn intern_def() -> DefId {
    static NEXT: AtomicUsize = AtomicUsize::new(1);
    NEXT.fetch_add(1, Ordering::Relaxed) as DefId
}

// ---------------------------------------------------------------------------
// Scope tree manager
// ---------------------------------------------------------------------------

/// Manages the scope tree keyed by ScopeId for O(1) parent traversal.
#[derive(Debug)]
pub struct ScopeTree {
    /// All scopes keyed by ID.
    scopes: HashMap<ScopeId, Scope>,
}

impl ScopeTree {
    pub fn new() -> Self {
        let mut tree = HashMap::new();
        tree.insert(ScopeId(0), Scope::root());
        ScopeTree { scopes: tree }
    }

    /// Returns the root scope's ID.
    pub fn root_id(&self) -> ScopeId { ScopeId(0) }

    /// Looks up a name by walking parent IDs from `scope_id`.
    /// Returns the DefId of the first (innermost) match, or None.
    pub fn lookup(&self, name: &str, mut scope_id: ScopeId) -> Option<DefId> {
        loop {
            if let Some(def_id) = self.scopes.get(&scope_id)?.get(name) {
                return Some(*def_id);
            }
            scope_id = self.scopes.get(&scope_id)?.parent_id?;
        }
    }

    /// Visits all scopes in post-order (children first) so inner bindings shadow outer.
    pub fn for_each_binding<F: FnMut(ScopeId, &str, DefId)>(&self, mut f: F) {
        let mut stack = vec![ScopeId(0)];
        let mut visited = HashMap::<ScopeId, bool>::new();
        while let Some(id) = stack.pop() {
            if visited.get(&id) == Some(&true) {
                if let Some(scope) = self.scopes.get(&id) {
                    for (name, &def_id) in &scope.bindings {
                        f(id, name, def_id);
                    }
                }
            } else {
                visited.insert(id, true);
                stack.push(id);
                if let Some(scope) = self.scopes.get(&id) {
                    if let Some(pid) = scope.parent_id {
                        stack.push(pid);
                    }
                }
            }
        }
    }
}

impl Default for ScopeTree {
    fn default() -> Self { Self::new() }
}

// ---------------------------------------------------------------------------
// ResolveResult
// ---------------------------------------------------------------------------

/// Result of name resolution, carrying the full scope tree.
#[derive(Debug)]
pub struct ResolveResult {
    pub root_scope: ScopeId,
    /// Flat map: symbol name → DefId for the first (innermost) binding site.
    pub symbols: HashMap<String, DefId>,
}

// ---------------------------------------------------------------------------
// Core API
// ---------------------------------------------------------------------------

pub fn resolve_program(prog: &Program) -> Result<ResolveResult, Vec<String>> {
    let mut tree = ScopeTree::new();
    let mut symbols = HashMap::new();
    let mut errors = Vec::new();

    // Register builtin.
    tree.scopes.get_mut(&ScopeId(0)).unwrap().put("print".to_string(), 0);

    resolve_Stmt(&prog.stmts, ScopeId(0), &mut tree, &mut symbols, &mut errors);

    if !errors.is_empty() { return Err(errors); }
    Ok(ResolveResult { root_scope: tree.root_id(), symbols })
}

// ---------------------------------------------------------------------------
// Statement visitor
// ---------------------------------------------------------------------------

fn resolve_Stmt(
    stmt: &Stmt,
    scope_id: ScopeId,
    tree: &mut ScopeTree,
    symbols: &mut HashMap<String, DefId>,
    _errors: &mut Vec<String>,
) {
    match stmt {
        Stmt::Fn { name, params, body, .. } => {
            let def_id = intern_def();
            let child_id = ScopeId::next();
            let parent_id = scope_id;
            {
                let mut child = Scope::child(parent_id);
                for p in params {
                    child.put(p.clone(), intern_def());
                }
                tree.scopes.insert(child_id, child);
            }
            bind(name.clone(), def_id, scope_id, tree, symbols);
            resolve_Stmts(body, child_id, tree, symbols, _errors);
        }
        Stmt::Block(inner) => {
            let child_id = ScopeId::next();
            tree.scopes.insert(child_id, Scope::child(scope_id));
            resolve_Stmts(inner, child_id, tree, symbols, _errors);
        }
        Stmt::If { then_body, else_body, .. } => {
            let c1 = ScopeId::next();
            let c2 = ScopeId::next();
            tree.scopes.insert(c1, Scope::child(scope_id));
            tree.scopes.insert(c2, Scope::child(scope_id));
            resolve_Stmts(then_body, c1, tree, symbols, _errors);
            resolve_Stmts(else_body, c2, tree, symbols, _errors);
        }
        Stmt::Loop { body } | Stmt::For { body, .. } | Stmt::While { body, .. } => {
            let child_id = ScopeId::next();
            tree.scopes.insert(child_id, Scope::child(scope_id));
            resolve_Stmts(body, child_id, tree, symbols, _errors);
        }
        Stmt::WhileIn { var_name, body, .. } => {
            let child_id = ScopeId::next();
            let mut child = Scope::child(scope_id);
            child.put(var_name.clone(), intern_def());
            tree.scopes.insert(child_id, child);
            resolve_Stmts(body, child_id, tree, symbols, _errors);
        }
        Stmt::Unsafe { body } => {
            let child_id = ScopeId::next();
            tree.scopes.insert(child_id, Scope::child(scope_id));
            resolve_Stmts(body, child_id, tree, symbols, _errors);
        }
        Stmt::Let(name, _) => { bind(name.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::Assign(name, _) => { bind(name.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::LetLinear(name, _) => { bind(name.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::Struct { name, .. } => { bind(name.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::Enum { name, .. } => { bind(name.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::ErrorSet { name, .. } => { bind(name.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::Impl { target, .. } => { bind(target.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::Trait { name, .. } => { bind(name.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::TypeAlias { name, .. } => { bind(name.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::Actor { name, .. } => { bind(name.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::DocComment { target, .. } => { bind(target.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::Capability { name, .. } => { bind(name.clone(), intern_def(), scope_id, tree, symbols); }
        Stmt::Use { path, alias } => {
            let name = alias.clone().unwrap_or_else(|| path.split('.').last().unwrap_or(path).to_string());
            bind(name, intern_def(), scope_id, tree, symbols);
        }
        // Non-binding:
        Stmt::Print(_) | Stmt::ExprStmt(_) | Stmt::Return(_) | Stmt::Break | Stmt::Continue
        | Stmt::ExprFieldAssign(_, _, _) | Stmt::GcMode { .. } | Stmt::CancelToken { .. }
        | Stmt::EffectHandler { .. } | Stmt::Spawn { .. } | Stmt::Channel { .. }
        | Stmt::WorkStealingExecutor { .. } | Stmt::DeterministicRuntime { .. }
        | Stmt::Tensor { .. } | Stmt::Simd { .. } | Stmt::DebugSession { .. }
        | Stmt::FfiSandbox { .. } => {}
    }
}

fn resolve_Stmts(
    stmts: &[Stmt],
    scope_id: ScopeId,
    tree: &mut ScopeTree,
    symbols: &mut HashMap<String, DefId>,
    errors: &mut Vec<String>,
) {
    for s in stmts { resolve_Stmt(s, scope_id, tree, symbols, errors); }
}

fn bind(
    name: String,
    def_id: DefId,
    scope_id: ScopeId,
    tree: &mut ScopeTree,
    symbols: &mut HashMap<String, DefId>,
) {
    // First binding wins in the flat map (outermost scope for shadowing semantics).
    symbols.entry(name.clone()).or_insert(def_id);
    tree.scopes.get_mut(&scope_id).unwrap().put(name, def_id);
}

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------
#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_root_id_zero() {
        let t = ScopeTree::new();
        assert_eq!(t.root_id(), ScopeId(0));
    }

    #[test]
    fn test_child_has_parent() {
        let t = ScopeTree::new();
        let c = ScopeId::next();
        t.scopes.insert(c, Scope::child(ScopeId(0)));
        assert_eq!(t.scopes.get(&c).unwrap().parent_id, Some(ScopeId(0)));
    }

    #[test]
    fn test_lookup_self() {
        let mut t = ScopeTree::new();
        t.scopes.get_mut(&ScopeId(0)).unwrap().put("x".to_string(), 42);
        assert_eq!(t.lookup("x", ScopeId(0)), Some(42));
        assert_eq!(t.lookup("y", ScopeId(0)), None);
    }

    #[test]
    fn test_lookup_parent_chain() {
        let mut t = ScopeTree::new();
        t.scopes.get_mut(&ScopeId(0)).unwrap().put("x".to_string(), 1);
        let c1 = ScopeId::next();
        let mut s = Scope::child(ScopeId(0));
        s.put("y".to_string(), 2);
        t.scopes.insert(c1, s);
        let c2 = ScopeId::next();
        let mut s = Scope::child(c1);
        s.put("z".to_string(), 3);
        t.scopes.insert(c2, s);

        assert_eq!(t.lookup("z", c2), Some(3));
        assert_eq!(t.lookup("y", c2), Some(2));
        assert_eq!(t.lookup("x", c2), Some(1));
        assert_eq!(t.lookup("missing", c2), None);
    }
}