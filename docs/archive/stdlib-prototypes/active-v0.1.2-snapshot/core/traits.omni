-- Core traits for Omni

pub trait Copy[T]
pub trait Clone[T]
pub trait Drop[T]

pub trait PartialEq[T]
    fn eq(self, other: T) -> Bool

pub trait Eq[T] extends PartialEq[T]

pub trait PartialOrd[T] extends PartialEq[T]
    fn partial_cmp(self, other: T) -> Option[Int]

pub trait Ord[T] extends Eq[T]
    fn cmp(self, other: T) -> Int

pub trait Hash[T]
    fn hash(self) -> Int

pub trait Default[T]
    fn default() -> T

pub trait Display[T]
    fn display(self) -> String

pub trait Debug[T]
    fn debug(self) -> String

pub trait Iterator[T, U]
    fn next(self) -> Option[U]

pub trait IntoIterator[T, U]
    fn into_iter(self) -> Iterator[T, U]

pub trait From[T]
    fn from(value: T) -> Self

pub trait Into[T]
    fn into(self) -> T

pub trait TryFrom[T]
    fn try_from(value: T) -> Result[Self, Error]

pub trait TryInto[T]
    fn try_into(self) -> Result[T, Error]

pub trait Error
    fn description(self) -> String

pub trait Try[T, E]
    fn try(self) -> Result[T, E]

pub trait Send[T]
pub trait Sync[T]
pub trait AsyncDrop[T]