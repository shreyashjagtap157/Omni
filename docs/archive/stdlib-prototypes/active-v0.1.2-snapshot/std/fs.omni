-- Filesystem IO and Capabilities

pub struct FilesystemCap {}

pub struct File {
    fd: Int,
}

fn File.open(path: String, cap: &FilesystemCap) -> Result[File, Error]
fn File.create(path: String, cap: &FilesystemCap) -> Result[File, Error]

impl Read for File
    fn read(self, buf: &mut [u8]) -> Result[Int, Error]
    fn read_to_string(self, s: &mut String) -> Result[Int, Error]

impl Write for File
    fn write(self, buf: &[u8]) -> Result[Int, Error]
    fn flush(self) -> Result[(), Error]

pub fn read_to_string(path: String, cap: &FilesystemCap) -> Result[String, Error]
pub fn write(path: String, data: &[u8], cap: &FilesystemCap) -> Result[(), Error]
