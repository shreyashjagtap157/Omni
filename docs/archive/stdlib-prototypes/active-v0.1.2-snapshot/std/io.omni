-- IO Traits

pub trait Read
    fn read(self, buf: &mut [u8]) -> Result[Int, Error]
    fn read_to_string(self, s: &mut String) -> Result[Int, Error]

pub trait Write
    fn write(self, buf: &[u8]) -> Result[Int, Error]
    fn flush(self) -> Result[(), Error]

pub trait AsyncRead
    async fn read(self, buf: &mut [u8]) -> Result[Int, Error]

pub trait AsyncWrite
    async fn write(self, buf: &[u8]) -> Result[Int, Error]
    async fn flush(self) -> Result[(), Error]
